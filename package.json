{
  "name": "camera-circular",
  "version": "0.2.1",
  "description": "Câmera flutuante para gravar tutoriais no Mac: círculo, quadrado ou retângulo, com borda opcional.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "release": "sh scripts/release.sh"
  },
  "build": {
    "appId": "com.haydentech.camera-circular",
    "productName": "Camera Circular",
    "artifactName": "Camera-Circular-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "nederhayden",
      "repo": "camera-circular",
      "releaseType": "release"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-settings.js",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "A Câmera Circular usa a câmera para mostrar você na tela enquanto grava tutoriais.",
        "LSUIElement": true
      }
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
